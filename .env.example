# --- 通用 ---
TZ=Asia/Shanghai
SYSTEMS=checkout,pay
LOG_ROOT=/data/logs
# local：本机目录（CI / fixture）；sftp：生产拉取
LOG_SOURCE=local
# stub：默认占位分析；workbuddy：需凭证，缺凭证时 analysis_status=skipped_no_creds
ANALYZER=stub

# --- SFTP（生产 LOG_SOURCE=sftp）---
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_KEY_PATH=
SFTP_PASSWORD=

# --- MySQL（本机）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=logagg

# --- 公司内部 SMTP（未配置主机则 notify skipped_no_smtp）---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
MAIL_FROM=
MAIL_TO=

# --- WorkBuddy Managed Agents（Slice 1 不发真实 HTTP；勿编造聊天 schema）---
WORKBUDDY_AGENT_ID=
WORKBUDDY_VERSION_ID=
WORKBUDDY_AGENT_KEY=
WORKBUDDY_SECRET_ID=
WORKBUDDY_SECRET_KEY=

# --- 可选调优 ---
MAX_NEW_BYTES=67108864
MAX_NEW_FINGERPRINTS=20
